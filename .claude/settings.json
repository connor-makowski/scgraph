
{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "plan",
    "allow": [
      "Read(./scgraph/**)",
      "Edit(./scgraph/**)",
      "Write(./scgraph/**)",
      "Read(./test/**)",
      "Edit(./test/**)",
      "Write(./test/**)",
      "Read(./examples/**)",
      "Edit(./examples/**)",
      "Write(./examples/**)",
      "Read(./README.md)",
      "Edit(./README.md)",
      "Write(./README.md)",
      "Bash(uv run pytest)",
      "Bash(uv run pytest test/*.py)",
      "Bash(uv run utils/prettify.py)",
      "Bash(uv run nox -s lint)",
      "Read(./.claude/**)",
      "Edit(./.claude/CLAUDE.md)",
      "Write(./.claude/CLAUDE.md)"
    ],
    "deny": [
      "Bash(rm *)",
      "Bash(git *)",
      "Read(cache/**)",
      "Read(dist/**)",
      "Read(**/__pycache__/**)",
      "Read(**/venv/**)",
      "Read(geographs/**)",
      "Read(**.json)"
    ]
  }
}